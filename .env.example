# ---- Backend (FastAPI) ----
# Comma-separated list of origins allowed to call the API (your Vite dev server and Vercel URL).
FLEECE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Which player dataset to load: "snapshot" (the real-data snapshot written by scripts/update_data.py)
# or a path to another projections CSV in the same format.
FLEECE_DATA_SOURCE=snapshot

# ---- Frontend (Vite) ----
# Base URL of the backend API, read by the React app.
VITE_API_BASE_URL=http://localhost:8000
